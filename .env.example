# Required outside local development. Plugin clients send this as x-api-key.
API_KEY=change-me
# Optional. When set, the dashboard asks for it and /api/* reads require it.
DASHBOARD_KEY=
# Delete spans older than N days (0 = keep forever).
RETENTION_DAYS=0
PORT=4318
# DB_PATH=./data/monitor.db
# PRICING_FILE=/path/to/pricing.json

# Public hostname for the HTTPS deployment (DNS A record -> your VM). Not needed for the local compose file.
DOMAIN=monitor.example.com
